<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Art3m1s.PsvTool.App"
        xmlns:core="using:Art3m1s.PsvTool.Core"
        x:Class="Art3m1s.PsvTool.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1180" Height="1000" MinWidth="900" MinHeight="680"
        Icon="avares://Art3m1s.PsvTool.App/Assets/app-icon.png"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="28,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
        <Border Grid.ColumnSpan="4" Height="3" Margin="-28,-20,-28,0" VerticalAlignment="Top" CornerRadius="0,0,3,3">
          <Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#087EFF" Offset="0"/><GradientStop Color="#42D9FF" Offset="0.55"/><GradientStop Color="#8C67FF" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="52" Height="52" CornerRadius="14" Background="#081126" BoxShadow="0 5 18 0 #50087EFF">
            <Image Source="avares://Art3m1s.PsvTool.App/Assets/app-icon.png" Width="50" Height="50" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Content="中文" Click="ChineseClick" Classes="preset" />
          <Button Content="English" Click="EnglishClick" Classes="preset" />
        </StackPanel>
        <Button Grid.Column="2" Content="{Binding ThemeValue}" Click="ThemeClick" Classes="preset" VerticalAlignment="Center" />
        <Button Grid.Column="3" Content="{Binding AboutLabel}" Click="AboutClick" Classes="preset" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="MainScroll" Grid.Row="1">
      <Grid Margin="28,22" ColumnDefinitions="1.3*,1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="18">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding ProjectLabel}" Classes="sectionTitle" />
            <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
              <TextBlock Text="{Binding InputLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding InputDirectory}" PlaceholderText="C:\Games\ArtemisGame" />
              <Button Grid.Column="2" Content="{Binding BrowseLabel}" Click="BrowseInputClick" />
              <TextBlock Grid.Row="1" Text="{Binding OutputLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputDirectory}" PlaceholderText="C:\Games\ArtemisGame-PSV" />
              <Button Grid.Row="1" Grid.Column="2" Content="{Binding BrowseLabel}" Click="BrowseOutputClick" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <Border Background="{DynamicResource AccentBg}" CornerRadius="99" Padding="12,5" HorizontalAlignment="Left">
                <TextBlock Text="{Binding ScanSummary}" Foreground="#268DF4" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Border>
              <Button Grid.Column="1" Content="{Binding ScanLabel}" Click="ScanClick" IsEnabled="{Binding CanStart}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="card">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding RatioLabel}" Classes="sectionTitle" VerticalAlignment="Center" />
              <Button x:Name="AutoScanResolutionButton" Grid.Column="1" Content="{Binding AutoScanResolutionLabel}" Click="AutoScanResolutionClick" IsEnabled="{Binding CanStart}" Classes="preset" />
            </Grid>
            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
              <TextBox Text="{Binding Ratio, UpdateSourceTrigger=PropertyChanged}" FontSize="22" HorizontalContentAlignment="Center" />
              <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="0.75 · 720p" Click="Ratio075Click" Classes="preset" Margin="0,0,6,6" />
                <Button Content="0.5 · 1080p" Click="Ratio05Click" Classes="preset" Margin="0,0,6,6" />
                <Button Content="0.375 · 2K" Click="Ratio0375Click" Classes="preset" Margin="0,0,6,6" />
                <Button Content="0.25 · 4K" Click="Ratio025Click" Classes="preset" Margin="0,0,6,6" />
              </WrapPanel>
            </Grid>
            <TextBlock Text="{Binding RatioHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
            <StackPanel Spacing="5" IsVisible="{Binding HasResolutionChoices}">
              <TextBlock Text="{Binding ResolutionListLabel}" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
              <ListBox x:Name="ResolutionListBox" ItemsSource="{Binding ResolutionChoices}" SelectedIndex="{Binding SelectedResolutionIndex}" MaxHeight="112" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Background="{DynamicResource SubtleBg}" CornerRadius="8" Padding="14">
                <StackPanel><TextBlock Text="{Binding OriginalLabel}" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="{Binding OriginalResolution}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource AccentBg}" CornerRadius="8" Padding="14">
                <StackPanel><TextBlock Text="{Binding TargetLabel}" Foreground="#83BEFF" /><TextBlock Text="{Binding TargetResolution}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding TypesLabel}" Classes="sectionTitle" />
            <CheckBox Content="{Binding TextLabel}" IsChecked="{Binding ProcessText}" />
            <CheckBox Content="{Binding ImagesLabel}" IsChecked="{Binding ProcessImages}" />
            <CheckBox Content="{Binding AnimationLabel}" IsChecked="{Binding ProcessAnimation}" />
            <CheckBox Content="{Binding VideoLabel}" IsChecked="{Binding ProcessVideo}" />
            <Grid ColumnDefinitions="*,190" ColumnSpacing="10">
              <CheckBox Content="{Binding FontSubsetLabel}" IsChecked="{Binding SubsetFonts}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FontProfiles}" SelectedIndex="{Binding FontProfile}" IsEnabled="{Binding SubsetFonts}" />
            </Grid>
            <TextBlock Text="{Binding FontSubsetHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
            <Border Background="{DynamicResource SubtleBg}" CornerRadius="8" Padding="12" Margin="0,5,0,0">
              <StackPanel><TextBlock Text="{Binding ModeLabel}" FontWeight="SemiBold" Foreground="#278BEE" /><TextBlock Text="{Binding ModeHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" /></StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="card" IsEnabled="{Binding CanStart}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding PsbTitle}" Classes="sectionTitle" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="ScanPsbButton" Grid.Column="1" Content="{Binding ScanPsbLabel}" Click="ScanPsbClick" />
            </Grid>
            <TextBlock Text="{Binding PsbHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
            <CheckBox IsChecked="{Binding IndependentPsbTextureScaling}">
              <TextBlock Text="{Binding IndependentPsbTextureScalingLabel}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{Binding PsbEmptyHelp}" IsVisible="{Binding !HasPsbCategories}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
            <Expander Header="{Binding PsbDxt5Title}">
              <TextBlock Text="{Binding PsbDxt5Help}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
            </Expander>
            <ItemsControl ItemsSource="{Binding PsbCategories}" IsEnabled="{Binding IndependentPsbTextureScaling}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PsbCategoryViewModel">
                  <Border Background="{DynamicResource SubtleBg}" Padding="10" Margin="0,0,0,6" CornerRadius="6">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="140,65,85,100,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Ratio" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Ratio, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Presets}" SelectedIndex="{Binding SelectedPreset}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Column="4" Text="{Binding Preview}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="5" Text="{Binding Count}" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="{Binding MemoryComparison}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding RenderCompensation}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding Validation}" IsVisible="{Binding HasValidationError}" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" />
                      <Expander Header="{Binding DetailsLabel}" IsVisible="{Binding HasFiles}">
                        <ListBox ItemsSource="{Binding FileRows}" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Classes="card" IsEnabled="{Binding CanStart}">
          <StackPanel Spacing="10">
            <CheckBox Content="{Binding NativeTexturesLabel}" IsChecked="{Binding NativeTextures}" />
            <TextBlock Text="{Binding NativeTexturesHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
            <StackPanel IsEnabled="{Binding NativeTextures}" Spacing="10">
              <Button Content="{Binding ScanTexturesLabel}" Click="ScanTexturesClick" HorizontalAlignment="Left" />
              <CheckBox Content="{Binding IgnoreBackgroundAlphaLabel}" IsChecked="{Binding IgnoreBackgroundAlpha}" />
              <ItemsControl ItemsSource="{Binding TextureCategories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TextureCategoryViewModel">
                    <Border Background="{DynamicResource SubtleBg}" Padding="10" Margin="0,0,0,8" CornerRadius="6">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedFormat}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="720" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <Expander Header="{Binding DetailsLabel}" IsExpanded="{Binding DetailsExpanded, Mode=TwoWay}">
                          <ListBox ItemsSource="{Binding FileRows}" MaxHeight="220"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
                          </ListBox>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding TextureHelp}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
            <Expander Header="{Binding TextureFormatsLabel}" IsExpanded="True">
              <ItemsControl ItemsSource="{Binding TextureFormats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:NativeFormatInfo">
                    <Grid ColumnDefinitions="210,55,210,*" ColumnSpacing="8" Margin="0,4">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding BitsPerPixel}" />
                      <TextBlock Grid.Column="2" Text="{Binding Channels}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="3" Text="{Binding Description}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="2" Classes="card">
          <Grid ColumnDefinitions="1*,2*" ColumnSpacing="18">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AdvancedLabel}" Classes="sectionTitle" />
              <Grid ColumnDefinitions="*,210"><TextBlock Text="{Binding ParallelLabel}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ParallelChoices}" SelectedIndex="{Binding SelectedParallel}" /></Grid>
              <Grid ColumnDefinitions="*,210"><TextBlock Text="{Binding EncodingLabel}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding EncodingChoices}" SelectedIndex="{Binding SelectedEncoding}" /></Grid>
              <CheckBox IsChecked="{Binding IgnorePfsVideos}">
                <TextBlock Text="{Binding IgnorePfsVideosLabel}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding ConvertEmotePsbTexturesToDxt5}">
                <TextBlock Text="{Binding ConvertEmotePsbTexturesToDxt5Label}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Text="{Binding ConvertEmotePsbTexturesToDxt5Help}" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryText}" FontSize="12" />
              <CheckBox IsChecked="{Binding PsbRenderCompensation}" IsEnabled="{Binding IndependentPsbTextureScaling}">
                <TextBlock Text="{Binding PsbRenderCompensationLabel}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Text="{Binding PsbRenderCompensationHelp}" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryText}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="{Binding LogLabel}" Classes="sectionTitle" />
              <TextBox x:Name="LogTextBox" Text="{Binding Log}" TextChanged="LogTextChanged"
                       IsReadOnly="True" AcceptsReturn="True" Height="110" TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono, Consolas" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" Padding="28,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <Border Grid.Row="0" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningBorder}"
                BorderThickness="1" CornerRadius="7" Padding="12,8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Text="!" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding AssetRightsBackupWarning}" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Status}" /><ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Margin="0,7,20,0" /></StackPanel>
          <Button Grid.Column="1" Content="{Binding CancelLabel}" Click="CancelClick" IsEnabled="{Binding IsBusy}" />
          <Button Grid.Column="2" Content="{Binding StartLabel}" Click="StartClick" IsEnabled="{Binding CanStart}" Classes="primary" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
